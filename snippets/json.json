{
  "PWA Manifest (Guided IntelliSense)": {
    "prefix": "pwa.manifest",
    "description": "Create a production-ready manifest.json with guided fields, dropdowns, and inline explanations",
    "body": [
      "{",
      "  \"name\": \"${1:My Progressive Web App}\", // Full app name (shown on install)",
      "  \"short_name\": \"${2:MyApp}\", // Short label for home screen",
      "  \"description\": \"${3:A fast and reliable PWA}\",",
      "  \"start_url\": \"${4:/}\", // Entry point",
      "  \"scope\": \"${5:/}\",",
      "  \"display\": \"${6|standalone,fullscreen,minimal-ui,browser|}\", // App display mode",
      "  \"orientation\": \"${7|portrait,landscape|}\",",
      "  \"background_color\": \"${8:#ffffff}\",",
      "  \"theme_color\": \"${9:#000000}\",",
      "  \"icons\": [",
      "    {",
      "      \"src\": \"${10:/icons/icon-192.png}\",",
      "      \"sizes\": \"192x192\",",
      "      \"type\": \"image/png\"",
      "    },",
      "    {",
      "      \"src\": \"${11:/icons/icon-512.png}\",",
      "      \"sizes\": \"512x512\",",
      "      \"type\": \"image/png\"",
      "    }",
      "  ]",
      "}"
    ]
  }
}