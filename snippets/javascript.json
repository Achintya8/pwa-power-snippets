{
  "Register Service Worker (Safe)": {
    "prefix": "pwa.register",
    "description": "Register service worker with load event and error handling",
    "body": [
      "if ('serviceWorker' in navigator) {",
      "  window.addEventListener('load', () => {",
      "    navigator.serviceWorker.register('${1:/sw.js}')",
      "      .then(reg => console.log('SW registered:', reg))",
      "      .catch(err => console.error('SW failed:', err));",
      "  });",
      "}"
    ]
  },

  "Cache First Strategy (Offline First)": {
    "prefix": "pwa.sw.cache",
    "description": "Cache-first strategy: fastest, works offline",
    "body": [
      "self.addEventListener('fetch', event => {",
      "  event.respondWith(",
      "    caches.match(event.request).then(res => {",
      "      return res || fetch(event.request).then(fetchRes => {",
      "        return caches.open('${1:cache-v1}').then(cache => {",
      "          cache.put(event.request, fetchRes.clone());",
      "          return fetchRes;",
      "        });",
      "      });",
      "    })",
      "  );",
      "});"
    ]
  },

  "Network First Strategy (Fresh Data)": {
    "prefix": "pwa.sw.network",
    "description": "Network-first: always try network, fallback to cache",
    "body": [
      "self.addEventListener('fetch', event => {",
      "  event.respondWith(",
      "    fetch(event.request)",
      "      .then(res => {",
      "        const clone = res.clone();",
      "        caches.open('${1:cache-v1}').then(cache => cache.put(event.request, clone));",
      "        return res;",
      "      })",
      "      .catch(() => caches.match(event.request))",
      "  );",
      "});"
    ]
  },

  "Install Prompt Handler (Custom UI)": {
    "prefix": "pwa.install",
    "description": "Control PWA install prompt manually",
    "body": [
      "let deferredPrompt;",
      "",
      "window.addEventListener('beforeinstallprompt', e => {",
      "  e.preventDefault();",
      "  deferredPrompt = e;",
      "  console.log('Install prompt ready');",
      "});",
      "",
      "async function installApp() {",
      "  if (!deferredPrompt) return;",
      "  deferredPrompt.prompt();",
      "  const { outcome } = await deferredPrompt.userChoice;",
      "  console.log('User choice:', outcome);",
      "  deferredPrompt = null;",
      "}"
    ]
  },

  "Offline Fallback (User Friendly)": {
    "prefix": "pwa.offline",
    "description": "Serve offline page when network fails",
    "body": [
      "const OFFLINE_URL = '${1:/offline.html}';",
      "",
      "self.addEventListener('install', event => {",
      "  event.waitUntil(",
      "    caches.open('${2:offline-cache}').then(cache => cache.add(OFFLINE_URL))",
      "  );",
      "});",
      "",
      "self.addEventListener('fetch', event => {",
      "  event.respondWith(",
      "    fetch(event.request).catch(() => caches.match(OFFLINE_URL))",
      "  );",
      "});"
    ]
  },

  "Push Notifications (Basic)": {
    "prefix": "pwa.push",
    "description": "Handle push notifications in service worker",
    "body": [
      "self.addEventListener('push', event => {",
      "  const data = event.data.json();",
      "  event.waitUntil(",
      "    self.registration.showNotification(data.title, {",
      "      body: data.body,",
      "      icon: '${1:/icons/icon.png}'",
      "    })",
      "  );",
      "});"
    ]
  }
}