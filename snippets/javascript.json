{
  "Register Service Worker (Safe)": {
    "prefix": "pwa.register",
    "description": "Register service worker with load event and error handling",
    "body": [
      "if ('serviceWorker' in navigator) {",
      "  window.addEventListener('load', () => {",
      "    navigator.serviceWorker.register('${1:/sw.js}')",
      "      .then(reg => console.log('SW registered:', reg))",
      "      .catch(err => console.error('SW failed:', err));",
      "  });",
      "}"
    ]
  },

  "Cache First Strategy (Offline First)": {
    "prefix": "pwa.sw.cache",
    "description": "Cache-first strategy: fastest, works offline",
    "body": [
      "self.addEventListener('fetch', event => {",
      "  event.respondWith(",
      "    caches.match(event.request).then(res => {",
      "      return res || fetch(event.request).then(fetchRes => {",
      "        return caches.open('${1:cache-v1}').then(cache => {",
      "          cache.put(event.request, fetchRes.clone());",
      "          return fetchRes;",
      "        });",
      "      });",
      "    })",
      "  );",
      "});"
    ]
  },

  "Network First Strategy (Fresh Data)": {
    "prefix": "pwa.sw.network",
    "description": "Network-first: always try network, fallback to cache",
    "body": [
      "self.addEventListener('fetch', event => {",
      "  event.respondWith(",
      "    fetch(event.request)",
      "      .then(res => {",
      "        const clone = res.clone();",
      "        caches.open('${1:cache-v1}').then(cache => cache.put(event.request, clone));",
      "        return res;",
      "      })",
      "      .catch(() => caches.match(event.request))",
      "  );",
      "});"
    ]
  },

  "Install Prompt Handler (Custom UI)": {
    "prefix": "pwa.install",
    "description": "Control PWA install prompt manually",
    "body": [
      "let deferredPrompt;",
      "",
      "window.addEventListener('beforeinstallprompt', e => {",
      "  e.preventDefault();",
      "  deferredPrompt = e;",
      "  console.log('Install prompt ready');",
      "});",
      "",
      "async function installApp() {",
      "  if (!deferredPrompt) return;",
      "  deferredPrompt.prompt();",
      "  const { outcome } = await deferredPrompt.userChoice;",
      "  console.log('User choice:', outcome);",
      "  deferredPrompt = null;",
      "}"
    ]
  },

  "Offline Fallback (User Friendly)": {
    "prefix": "pwa.offline",
    "description": "Serve offline page when network fails",
    "body": [
      "const OFFLINE_URL = '${1:/offline.html}';",
      "",
      "self.addEventListener('install', event => {",
      "  event.waitUntil(",
      "    caches.open('${2:offline-cache}').then(cache => cache.add(OFFLINE_URL))",
      "  );",
      "});",
      "",
      "self.addEventListener('fetch', event => {",
      "  event.respondWith(",
      "    fetch(event.request).catch(() => caches.match(OFFLINE_URL))",
      "  );",
      "});"
    ]
  },

  "Push Notifications (Basic)": {
    "prefix": "pwa.push",
    "description": "Handle push notifications in service worker",
    "body": [
      "self.addEventListener('push', event => {",
      "  const data = event.data.json();",
      "  event.waitUntil(",
      "    self.registration.showNotification(data.title, {",
      "      body: data.body,",
      "      icon: '${1:/icons/icon.png}'",
      "    })",
      "  );",
      "});"
    ]
  },

  "Stale While Revalidate Strategy": {
    "prefix": "pwa.sw.stale",
    "description": "Serve cached content instantly, update from network in background",
    "body": [
      "self.addEventListener('fetch', event => {",
      "  event.respondWith(",
      "    caches.open('${1:cache-v1}').then(cache => {",
      "      return cache.match(event.request).then(cachedResponse => {",
      "        const fetchPromise = fetch(event.request).then(networkResponse => {",
      "          cache.put(event.request, networkResponse.clone());",
      "          return networkResponse;",
      "        });",
      "        return cachedResponse || fetchPromise;",
      "      });",
      "    })",
      "  );",
      "});"
    ]
  },

  "Cache Cleanup on Activate": {
    "prefix": "pwa.sw.cleanup",
    "description": "Delete outdated caches when new service worker activates",
    "body": [
      "const CACHE_NAME = '${1:cache-v2}';",
      "",
      "self.addEventListener('activate', event => {",
      "  event.waitUntil(",
      "    caches.keys().then(cacheNames => {",
      "      return Promise.all(",
      "        cacheNames.map(cache => {",
      "          if (cache !== CACHE_NAME) {",
      "            return caches.delete(cache);",
      "          }",
      "        })",
      "      );",
      "    })",
      "  );",
      "});"
    ]
  },

  "Skip Waiting and Claim Clients": {
    "prefix": "pwa.sw.update",
    "description": "Activate new service worker immediately without waiting",
    "body": [
      "self.addEventListener('install', () => {",
      "  self.skipWaiting();",
      "});",
      "",
      "self.addEventListener('activate', event => {",
      "  event.waitUntil(clients.claim());",
      "});"
    ]
  },

  "Background Sync Handler": {
    "prefix": "pwa.sync",
    "description": "Register and handle background sync for offline actions",
    "body": [
      "// Register background sync in main app thread",
      "async function registerSync(tag = '${1:sync-data}') {",
      "  const reg = await navigator.serviceWorker.ready;",
      "  if ('sync' in reg) {",
      "    await reg.sync.register(tag);",
      "    console.log('Background sync registered:', tag);",
      "  }",
      "}",
      "",
      "// Handle background sync event in service worker",
      "self.addEventListener('sync', event => {",
      "  if (event.tag === '${1:sync-data}') {",
      "    event.waitUntil(/* async sync function call */);",
      "  }",
      "});"
    ]
  },

  "App Badge API": {
    "prefix": "pwa.badge",
    "description": "Set or clear unread badge count on PWA app icon",
    "body": [
      "async function updateBadge(count) {",
      "  if ('setAppBadge' in navigator) {",
      "    try {",
      "      if (count > 0) {",
      "        await navigator.setAppBadge(count);",
      "      } else {",
      "        await navigator.clearAppBadge();",
      "      }",
      "    } catch (err) {",
      "      console.error('App badge error:', err);",
      "    }",
      "  }",
      "}"
    ]
  }
}